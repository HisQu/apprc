#!/usr/bin/env bash
# Repository-local AppRC example app environment.
# Source this file from a checkout root; it contains no secrets.

: "${PROJECT_ROOT:=$(pwd)}"
: "${APPRC_EXAMPLE_APPS_ROOT:=${PROJECT_ROOT}/examples/example_app_disk_files}"

export PROJECT_ROOT
export APPRC_EXAMPLE_APPS_ROOT
export XDG_CONFIG_HOME="${APPRC_EXAMPLE_APPS_ROOT}/xdg-config-home"

# == Explicit env layer defaults ============================================
: "${APPRC_EXAMPLE_ENV_ONLY_PROFILE:=explicit-env-profile}"
: "${APPRC_EXAMPLE_ENV_ONLY_DEBUG:=true}"
: "${APPRC_EXAMPLE_STORAGE_ENABLED:=false}"
: "${APPRC_EXAMPLE_STORAGE_RETRY_COUNT:=7}"
: "${APPRC_EXAMPLE_APP_WIDE_WORKERS:=8}"
: "${APPRC_EXAMPLE_APP_WIDE_STORAGE_REGION:=explicit-region}"
: "${APPRC_EXAMPLE_PRECEDENCE_LABEL:=explicit-env-label}"
: "${APPRC_EXAMPLE_RUNTIME_PROFILE:=explicit-runtime-profile}"

export APPRC_EXAMPLE_ENV_ONLY_PROFILE
export APPRC_EXAMPLE_ENV_ONLY_DEBUG
export APPRC_EXAMPLE_STORAGE_ENABLED
export APPRC_EXAMPLE_STORAGE_RETRY_COUNT
export APPRC_EXAMPLE_APP_WIDE_WORKERS
export APPRC_EXAMPLE_APP_WIDE_STORAGE_REGION
export APPRC_EXAMPLE_PRECEDENCE_LABEL
export APPRC_EXAMPLE_RUNTIME_PROFILE

# == Storage selectors =======================================================
: "${APPRC_EXAMPLE_STORAGE_ROOT:=${APPRC_EXAMPLE_APPS_ROOT}/.apprc-example-storage-only/storages/alpha}"
: "${APPRC_EXAMPLE_APP_WIDE_STORAGE_ROOT:=${APPRC_EXAMPLE_APPS_ROOT}/.apprc-example-app-wide-storage/storages/alpha}"
: "${APPRC_EXAMPLE_PRECEDENCE_ROOT:=${APPRC_EXAMPLE_APPS_ROOT}/.apprc-example-explicit-env-precedence/storages/alpha}"
: "${APPRC_EXAMPLE_RUNTIME_ROOT:=${APPRC_EXAMPLE_APPS_ROOT}/.apprc-example-cli-runtime/storages/alpha}"

export APPRC_EXAMPLE_STORAGE_ROOT
export APPRC_EXAMPLE_APP_WIDE_STORAGE_ROOT
export APPRC_EXAMPLE_PRECEDENCE_ROOT
export APPRC_EXAMPLE_RUNTIME_ROOT

# == Named-storage registries ===============================================
: "${APPRC_EXAMPLE_STORAGE_ONLY_APPRC_TOML:=${XDG_CONFIG_HOME}/apprc-example-storage-only/apprc-example-storage-only.apprc.toml}"
: "${APPRC_EXAMPLE_APP_WIDE_STORAGE_APPRC_TOML:=${XDG_CONFIG_HOME}/apprc-example-app-wide-storage/apprc-example-app-wide-storage.apprc.toml}"
: "${APPRC_EXAMPLE_EXPLICIT_ENV_PRECEDENCE_APPRC_TOML:=${XDG_CONFIG_HOME}/apprc-example-explicit-env-precedence/apprc-example-explicit-env-precedence.apprc.toml}"
: "${APPRC_EXAMPLE_CLI_RUNTIME_APPRC_TOML:=${XDG_CONFIG_HOME}/apprc-example-cli-runtime/apprc-example-cli-runtime.apprc.toml}"

export APPRC_EXAMPLE_STORAGE_ONLY_APPRC_TOML
export APPRC_EXAMPLE_APP_WIDE_STORAGE_APPRC_TOML
export APPRC_EXAMPLE_EXPLICIT_ENV_PRECEDENCE_APPRC_TOML
export APPRC_EXAMPLE_CLI_RUNTIME_APPRC_TOML
