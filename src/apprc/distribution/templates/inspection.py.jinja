#!/usr/bin/env python3
"""Read adjacent installation authority without provisioning dependencies."""

import base64
import io
import os
import runpy
import sys
import tempfile
from pathlib import PurePosixPath
from zipfile import ZipFile

_ARCHIVE = {{ archive | json }}


def main():
    with tempfile.TemporaryDirectory(prefix="apprc-inspect-") as temporary:
        root = os.path.abspath(temporary)
        os.chmod(root, 0o700)
        with ZipFile(io.BytesIO(base64.b64decode(_ARCHIVE, validate=True))) as archive:
            for info in archive.infolist():
                address = PurePosixPath(info.filename)
                if address.is_absolute() or ".." in address.parts or "\\" in info.filename:
                    raise RuntimeError("Unsafe inspection payload address.")
                target = os.path.join(root, *address.parts)
                os.makedirs(os.path.dirname(target), mode=0o700, exist_ok=True)
                with open(target, "xb") as stream:
                    stream.write(archive.read(info))
        sys.path.insert(0, root)
        runpy.run_module("apprc.distribution.runtime.inspection", run_name="__main__")


if __name__ == "__main__":
    main()
