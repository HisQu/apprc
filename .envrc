#!/usr/bin/env bash
# --- .envrc from buildben template ---
# !! Requires `direnv` 
# !! This script is executed EVERY TIME you enter the directory !!

# ===============================================================
# == Paths
# > uv is located there
PATH_add ~/.local/bin

export PROJECT_ROOT="$PWD"
export PROJECT_NAME="${PROJECT_NAME:-${PWD##*/}}"


# ===============================================================
# == Load .env and .envrc files 
dotenv_if_exists ./.env.shared
source_env_if_exists .envrc.private
dotenv_if_exists ./.env.template
source_env_if_exists .env.example_apps
dotenv_if_exists ./.env


# ===============================================================
# === venv 
layout_uv() {
    ### Config uv-managed venv
    export UV_PROJECT_ENVIRONMENT="$PWD/.venv"
    # > Force uv to use managed Python, disallow fallback to system Python
    export UV_MANAGED_PYTHON=1
    
    ### Re-evaluate .envrc when these change
    watch_file pyproject.toml
    watch_file uv.lock
    watch_file .env.example_apps
    
    ### Make .venv if not exists
    echo "-- Checking venv ---------------------------------------------------"
    if [[ ! -d "$UV_PROJECT_ENVIRONMENT" ]]; then
        echo "-- 🏗️  Creating .venv at $UV_PROJECT_ENVIRONMENT ..."
        # > --seed: Install `pip`, `setuptools`, and `wheel` into the new venv
        uv venv --seed "$UV_PROJECT_ENVIRONMENT"
        # > --all-extras: Install all published extras from [project.optional-dependencies], such as rag.
        # > --all-groups: Install all local groups from [dependency-groups], such as dev.
        # > --no-default-groups: Use this in explicit runtime-only commands to skip local dev groups.
        # > --frozen: Sync from uv.lock without changing it (ignoring the pyproject.toml)
        uv sync --frozen --all-extras --all-groups
    ### Check for differences
    else
        uv lock --check || echo "⚠️  Lock: pyproject.toml differs from ./uv.lock!"
        uv sync --check --all-extras --all-groups || echo "⚠️  Sync: .venv differs from ./uv.lock!"
    fi
    source "$UV_PROJECT_ENVIRONMENT"/bin/activate
}
layout_uv
export PIP_REQUIRE_VIRTUALENV=1 # > hard-fail if someone runs pip outside the venv


# ===============================================================
# == Example app disk files
bootstrap_example_apps_if_missing() {
    local example_root="${APPRC_EXAMPLE_APPS_ROOT:-$PROJECT_ROOT/examples/example_app_disk_files}"
    local expected_env="$example_root/.apprc-example-explicit-env-precedence/.env"
    local expected_config="$example_root/xdg-config-home/apprc-example-explicit-env-precedence/.env.apprc-app"
    local expected_storage="$example_root/.apprc-example-explicit-env-precedence/storages/alpha/.env.apprc-storage"

    if [[ ! -f "$expected_env" || ! -f "$expected_config" || ! -f "$expected_storage" ]]; then
        echo "-- Bootstrapping AppRC example app files at $example_root ..."
        python -m apprc_dev.example_apps.bootstrap --output-root "$example_root"
    fi
}
bootstrap_example_apps_if_missing


# ===============================================================
# == Echo env vars & info 
W=24
printf "%-*s  %s\n" $W "-- Info ---------------" " -----------------------------------------"
# --- Environment Variables
printf "%*s : %s\n" $W '$PROJECT_NAME' "$PROJECT_NAME"
printf "%*s : %s\n" $W '$PROJECT_ROOT' "$PROJECT_ROOT"
printf "%*s : %s\n" $W '$VIRTUAL_ENV' "$VIRTUAL_ENV"
printf "%*s : %s\n" $W '$PIP_REQUIRE_VIRTUALENV' "$PIP_REQUIRE_VIRTUALENV"
# --- Info
printf "%*s : %s\n" $W "Date" "$(date)"
printf "%*s : %s\n" $W "python" "$(python -S --version 2>&1) from $(which python)"
printf "%*s : %s\n" $W "pip" "$(pip --version)"
printf "%*s : %s\n" $W "uv" "$(uv --version) from $(which uv)"
printf "%-*s  %s\n" $W "------------------------" " -----------------------------------------"
