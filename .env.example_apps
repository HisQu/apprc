#!/usr/bin/env bash
# Repository-local AppRC example app environment.
# Source this file from a checkout root; it contains no secrets.

: "${PROJECT_ROOT:=$(pwd)}"
: "${APPRC_EXAMPLE_APPS_ROOT:=${PROJECT_ROOT}/examples/example_app_disk_files}"

export PROJECT_ROOT
export APPRC_EXAMPLE_APPS_ROOT

# == Explicit env layer defaults ============================================
: "${APPRC_EXAMPLE_CONFIG_PROFILE:=explicit-env-profile}"
: "${APPRC_EXAMPLE_CONFIG_DEBUG:=true}"
: "${APPRC_EXAMPLE_STORAGE_ENABLED:=false}"
: "${APPRC_EXAMPLE_STORAGE_RETRY_COUNT:=7}"
: "${APPRC_EXAMPLE_PRECEDENCE_LABEL:=explicit-env-label}"
: "${APPRC_EXAMPLE_RUNTIME_PROFILE:=explicit-runtime-profile}"

export APPRC_EXAMPLE_CONFIG_PROFILE
export APPRC_EXAMPLE_CONFIG_DEBUG
export APPRC_EXAMPLE_STORAGE_ENABLED
export APPRC_EXAMPLE_STORAGE_RETRY_COUNT
export APPRC_EXAMPLE_PRECEDENCE_LABEL
export APPRC_EXAMPLE_RUNTIME_PROFILE

# == Storage selectors =======================================================
: "${APPRC_EXAMPLE_STORAGE_ROOT:=alpha}"
: "${APPRC_EXAMPLE_PRECEDENCE_ROOT:=alpha}"
: "${APPRC_EXAMPLE_RUNTIME_ROOT:=alpha}"

export APPRC_EXAMPLE_STORAGE_ROOT
export APPRC_EXAMPLE_PRECEDENCE_ROOT
export APPRC_EXAMPLE_RUNTIME_ROOT

# == AppRC directories ======================================================
: "${APPRC_EXAMPLE_CONFIG_ONLY_APPRC_DIR:=${APPRC_EXAMPLE_APPS_ROOT}/apprc-directories/apprc-example-config-only}"
: "${APPRC_EXAMPLE_CONFIG_WITH_STORAGE_APPRC_DIR:=${APPRC_EXAMPLE_APPS_ROOT}/apprc-directories/apprc-example-config-with-storage}"
: "${APPRC_EXAMPLE_EXPLICIT_ENV_PRECEDENCE_APPRC_DIR:=${APPRC_EXAMPLE_APPS_ROOT}/apprc-directories/apprc-example-explicit-env-precedence}"
: "${APPRC_EXAMPLE_CLI_RUNTIME_APPRC_DIR:=${APPRC_EXAMPLE_APPS_ROOT}/apprc-directories/apprc-example-cli-runtime}"

export APPRC_EXAMPLE_CONFIG_ONLY_APPRC_DIR
export APPRC_EXAMPLE_CONFIG_WITH_STORAGE_APPRC_DIR
export APPRC_EXAMPLE_EXPLICIT_ENV_PRECEDENCE_APPRC_DIR
export APPRC_EXAMPLE_CLI_RUNTIME_APPRC_DIR
